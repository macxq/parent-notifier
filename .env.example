# ==========================================
# Konfiguracja eduVULCAN Notifier
# Skopiuj ten plik do .env i uzupełnij swoje dane
# ==========================================

# Dane logowania do eduVULCAN (konto rodzica)
VULCAN_USER=twoj_login_lub_email@domena.pl
VULCAN_PASSWORD=twoje_haslo_do_vulcana

# Wysyłka powiadomień przez Gmail SMTP
# Hasło aplikacji z: https://myaccount.google.com/apppasswords
SMTP_USER=twoj_email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_TO=odbiorca1@gmail.com,odbiorca2@gmail.com

# Inteligentna analiza ważności i kalendarza przez Google Gemini Flash
# Darmowy klucz z: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...

# Kalendarz Google (natywne przypomnienia dzwoneczkiem na telefonie 1 lub 2 dni przed)
# Identyfikator kalendarza z ustawień w calendar.google.com (np. c_xxxx@group.calendar.google.com)
GOOGLE_CALENDAR_ID=
# Ścieżka do pobranego pliku klucza Service Account (umieść go w data/service_account.json lub wklej treść do GOOGLE_SERVICE_ACCOUNT_JSON)
GOOGLE_SERVICE_ACCOUNT_FILE=data/service_account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=
