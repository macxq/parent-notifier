[MAIN]
# Ignoruj katalog danych i środowiska wirtualne
ignore=data,venv,.venv,__pycache__

[MESSAGES CONTROL]
# Wyłącz zbędne restrykcje stylistyczne, pilnując realnych błędów
disable=
    C0114, # missing-module-docstring
    C0115, # missing-class-docstring
    C0116, # missing-function-docstring
    C0301, # line-too-long
    R0912, # too-many-branches
    R0914, # too-many-locals
    R0915, # too-many-statements
    R0913, # too-many-arguments
    W0718, # broad-exception-caught
    W0621, # redefined-outer-name
    R0801, # duplicate-code
    C0103, # invalid-name

[FORMAT]
max-line-length=140

[DESIGN]
max-locals=30
max-branches=25
max-statements=100
